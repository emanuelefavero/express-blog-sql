@baseUrl = http://localhost:3000

### GET root endpoint
GET {{baseUrl}}/

### GET posts
GET {{baseUrl}}/posts

### GET posts filtered, searched and sorted
GET {{baseUrl}}/posts?tag=dolci&search=torta&sortBy=title&order=desc

### GET limited posts
GET {{baseUrl}}/posts?sortBy=id&order=desc&_limit=2

### 400 - Invalid limit
GET {{baseUrl}}/posts?_limit=abc

### 400 - Invalid sort field
GET {{baseUrl}}/posts?sortBy=date

### GET single post by ID
GET {{baseUrl}}/posts/1

### 400 - Invalid post ID
GET {{baseUrl}}/posts/abc

### 404 - Post not found
GET {{baseUrl}}/posts/999

### POST create a post for the CRUD flow
# @name createPost
POST {{baseUrl}}/posts
Content-Type: application/json

{
  "title": "Scialatielli ai frutti di mare",
  "content": "Gli scialatielli ai frutti di mare sono un primo piatto tipico della Costiera Amalfitana, preparato con pasta fresca e sapori del Mediterraneo.",
  "image": "scialatielli_frutti_mare.avif",
  "tags": ["primi piatti", "ricette di pesce", "cucina campana"]
}

### PUT the post created above
PUT {{baseUrl}}/posts/{{createPost.response.body.$.id}}
Content-Type: application/json

{
  "title": "Spaghetti al limone di Amalfi",
  "content": "Gli spaghetti al limone di Amalfi sono un primo piatto fresco e profumato, preparato con i celebri limoni della Costiera Amalfitana.",
  "image": "spaghetti_limone_amalfi.avif",
  "tags": ["primi piatti", "ricette vegetariane", "cucina campana"]
}

### DELETE the post created above
DELETE {{baseUrl}}/posts/{{createPost.response.body.$.id}}

### 400 - Invalid post ID when deleting
DELETE {{baseUrl}}/posts/abc

### 404 - Post to delete not found
DELETE {{baseUrl}}/posts/999

### 404
GET {{baseUrl}}/non-existent

### 415 - Unsupported charset (error handler middleware)
POST {{baseUrl}}/posts
Content-Type: application/json; charset=iso-8859-1

{}

### 500 - Internal Server Error (error handler middleware)
GET {{baseUrl}}/errors

### 503 - Service Unavailable (error handler middleware)
GET {{baseUrl}}/errors/unavailable
